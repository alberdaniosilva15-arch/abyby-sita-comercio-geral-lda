# NVIDIA_API_KEY: Required for DeepSeek via NVIDIA NIM
# Get it from build.nvidia.com
NVIDIA_API_KEY="nvapi-..."


# EmailJS configuration for real contact form submissions
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=

# Admin Dashboard
ADMIN_PASSWORD_HASH=
# TOTP 2FA — Segredo gerado pelo script scripts/setup-2fa.js
# Digitalizar o QR code com Google Authenticator / Authy.
# Se este segredo for alguma vez exposto/comprometido, correr o
# script novamente para gerar um segredo novo.
ADMIN_TOTP_SECRET=
JWT_SECRET=
# Cloudinary Credentials (Uploads de CVs e Certificados)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email para Notificação de Candidaturas
RECRUITMENT_EMAIL="recrutamento@abybysita.com"

# Supabase Credentials (Backend-only)
SUPABASE_URL=
SUPABASE_KEY=
